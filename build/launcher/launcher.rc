#include <windows.h>

/* app.ico is copied next to this file by build/build_portable.py */
1 ICON "app.ico"

1 VERSIONINFO
  FILEVERSION @VERSION_COMMA@
  PRODUCTVERSION @VERSION_COMMA@
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Windows Backup and Restore Toolkit"
      VALUE "FileDescription", "Windows Backup and Restore Toolkit"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "Backup_Restore_Toolkit"
      VALUE "OriginalFilename", "Backup_Restore_Toolkit_@VERSION@_Portable.exe"
      VALUE "ProductName", "Windows Backup and Restore Toolkit"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "LegalCopyright", "Free to use"
      VALUE "Comments", "Portable build - includes its own Python runtime"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
